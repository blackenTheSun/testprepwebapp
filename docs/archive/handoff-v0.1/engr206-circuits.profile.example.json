  "formulaSheet": [
    {
      "id": "ohms_law_voltage",
      "type": "formula/v1",
      "title": "Ohms law voltage form",
      "latex": "V = I R",
      "category": "Resistive circuits",
      "inputSlots": [
        {
          "id": "current",
          "symbol": "I",
          "quantityType": "current",
          "unit": "A"
        },
        {
          "id": "resistance",
          "symbol": "R",
          "quantityType": "resistance",
          "unit": "ohm"
        }
      ],
      "outputSlots": [
        {
          "id": "voltage",
          "symbol": "V",
          "quantityType": "voltage",
          "unit": "V"
        }
      ],
      "evaluation": {
        "type": "expression/v1",
        "assignments": {
          "voltage": "current * resistance"
        }
      },
      "teaching": {
        "whatToNotice": "A resistor has a known current and resistance, or one can be found first.",
        "whyThisOperation": "Ohms law converts the branch current into its voltage drop.",
        "commonMistakes": [
          "Using total source voltage instead of resistor voltage.",
          "Mixing kilo-ohms with amps without converting units."
        ]
      }
    },
    {
      "id": "power_passive_sign_convention",
      "type": "formula/v1",
      "title": "Power using passive sign convention",
      "latex": "p = v i",
      "category": "Power",
      "inputSlots": [
        {
          "id": "voltage",
          "symbol": "v",
          "quantityType": "voltage",
          "unit": "V"
        },
        {
          "id": "current",
          "symbol": "i",
          "quantityType": "current",
          "unit": "A"
        }
      ],
      "outputSlots": [
        {
          "id": "power",
          "symbol": "p",
          "quantityType": "power",
          "unit": "W"
        }
      ],
      "evaluation": {
        "type": "expression/v1",
        "assignments": {
          "power": "voltage * current"
        }
      },
      "teaching": {
        "whatToNotice": "Compare the current direction with marked voltage polarity before interpreting the result.",
        "whyThisOperation": "The sign of p tells whether the marked element absorbs or delivers power."
      }
    }
  ],
