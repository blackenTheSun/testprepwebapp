{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://guided-test-prep.local/schemas/test-file.local.v1.schema.json",
  "title": "Guided Test Prep Local Test File v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "apiVersion",
    "id",
    "title",
    "formulaSheet",
    "conversions",
    "problems"
  ],
  "properties": {
    "apiVersion": {
      "const": "guided-test-file.local/v1"
    },
    "id": {
      "$ref": "#/$defs/id"
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string"
    },
    "formulaSheet": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/formula"
      }
    },
    "conversions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/conversion"
      }
    },
    "problems": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/problem"
      }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9._-]{1,127}$"
    },
    "latex": {
      "oneOf": [
        {
          "type": "string"
        },
        {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      ]
    },
    "quantity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "symbol"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "name": {
          "type": "string"
        },
        "symbol": {
          "type": "string"
        },
        "unit": {
          "type": "string"
        },
        "quantityType": {
          "type": "string"
        },
        "latex": {
          "$ref": "#/$defs/latex"
        },
        "value": {
          "type": "number"
        }
      }
    },
    "slot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "symbol"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "name": {
          "type": "string"
        },
        "symbol": {
          "type": "string"
        },
        "unit": {
          "type": "string"
        },
        "quantityType": {
          "type": "string"
        }
      }
    },
    "formula": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "latex",
        "inputs",
        "output",
        "calculation",
        "teaching"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "title": {
          "type": "string"
        },
        "category": {
          "type": "string"
        },
        "latex": {
          "$ref": "#/$defs/latex"
        },
        "inputs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/slot"
          }
        },
        "output": {
          "$ref": "#/$defs/slot"
        },
        "calculation": {
          "$ref": "#/$defs/calculation"
        },
        "teaching": {
          "$ref": "#/$defs/formulaTeaching"
        }
      }
    },
    "calculation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "ast"
      ],
      "properties": {
        "kind": {
          "const": "expression/v1"
        },
        "ast": {
          "$ref": "#/$defs/expressionNode"
        }
      }
    },
    "expressionNode": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "op"
      ],
      "properties": {
        "op": {
          "enum": [
            "slot",
            "number",
            "add",
            "subtract",
            "multiply",
            "divide",
            "power",
            "negate",
            "abs",
            "sqrt"
          ]
        },
        "slot": {
          "$ref": "#/$defs/id"
        },
        "value": {
          "type": "number"
        },
        "args": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/expressionNode"
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "op": {
                "const": "slot"
              }
            }
          },
          "then": {
            "required": [
              "slot"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "op": {
                "const": "number"
              }
            }
          },
          "then": {
            "required": [
              "value"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "op": {
                "enum": [
                  "add",
                  "subtract",
                  "multiply",
                  "divide",
                  "power",
                  "negate",
                  "abs",
                  "sqrt"
                ]
              }
            }
          },
          "then": {
            "required": [
              "args"
            ]
          }
        }
      ]
    },
    "formulaTeaching": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "whatToNotice",
        "whyThisOperation"
      ],
      "properties": {
        "whatToNotice": {
          "type": "string"
        },
        "whyThisOperation": {
          "type": "string"
        },
        "commonMistakes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "conversion": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "fromUnit",
        "toUnit",
        "factor"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "title": {
          "type": "string"
        },
        "fromUnit": {
          "type": "string"
        },
        "toUnit": {
          "type": "string"
        },
        "factor": {
          "type": "number"
        },
        "outputName": {
          "type": "string"
        },
        "outputSymbol": {
          "type": "string"
        },
        "latex": {
          "$ref": "#/$defs/latex"
        }
      }
    },
    "prompt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "text"
      ],
      "properties": {
        "text": {
          "type": "string"
        },
        "latex": {
          "$ref": "#/$defs/latex"
        }
      }
    },
    "problem": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "prompt",
        "givens",
        "target",
        "allowedFormulaIds",
        "solutionPath"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "title": {
          "type": "string"
        },
        "prompt": {
          "$ref": "#/$defs/prompt"
        },
        "givens": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/quantity"
          }
        },
        "target": {
          "$ref": "#/$defs/slot"
        },
        "visual": {
          "$ref": "#/$defs/visual"
        },
        "allowedFormulaIds": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/id"
          }
        },
        "allowedConversionIds": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/id"
          }
        },
        "derivativeActions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/derivativeAction"
          }
        },
        "solutionPath": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/solutionStep"
          }
        }
      }
    },
    "visual": {
      "oneOf": [
        {
          "$ref": "#/$defs/latexVisual"
        },
        {
          "$ref": "#/$defs/diagram2d"
        },
        {
          "$ref": "#/$defs/scene3d"
        }
      ]
    },
    "latexVisual": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "altText",
        "latex"
      ],
      "properties": {
        "type": {
          "const": "latex/v1"
        },
        "altText": {
          "type": "string"
        },
        "latex": {
          "$ref": "#/$defs/latex"
        }
      }
    },
    "diagram2d": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "altText",
        "viewBox",
        "primitives"
      ],
      "properties": {
        "type": {
          "const": "diagram2d/v1"
        },
        "altText": {
          "type": "string"
        },
        "viewBox": {
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "items": {
            "type": "number"
          }
        },
        "primitives": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/diagramPrimitive"
          }
        }
      }
    },
    "diagramPrimitive": {
      "type": "object",
      "required": [
        "kind"
      ],
      "properties": {
        "kind": {
          "enum": [
            "line",
            "polyline",
            "arrow",
            "circle",
            "rect",
            "point",
            "text",
            "resistor",
            "voltageSource",
            "ground"
          ]
        }
      },
      "additionalProperties": true
    },
    "scene3d": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "altText",
        "camera",
        "objects"
      ],
      "properties": {
        "type": {
          "const": "scene3d/v1"
        },
        "altText": {
          "type": "string"
        },
        "camera": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "azimuthDeg",
            "elevationDeg"
          ],
          "properties": {
            "azimuthDeg": {
              "type": "number"
            },
            "elevationDeg": {
              "type": "number"
            },
            "scale": {
              "type": "number"
            },
            "projection": {
              "enum": [
                "orthographic",
                "perspective"
              ]
            }
          }
        },
        "objects": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/scene3dObject"
          }
        }
      }
    },
    "scene3dObject": {
      "type": "object",
      "required": [
        "kind"
      ],
      "properties": {
        "kind": {
          "enum": [
            "axes",
            "point",
            "line",
            "arrow",
            "plane",
            "box",
            "cylinder",
            "label"
          ]
        }
      },
      "additionalProperties": true
    },
    "derivativeAction": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "expressionLatex",
        "variable",
        "resultLatex",
        "output",
        "teaching"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "title": {
          "type": "string"
        },
        "expressionLatex": {
          "type": "string"
        },
        "variable": {
          "type": "string"
        },
        "resultLatex": {
          "type": "string"
        },
        "numericEvaluation": {
          "$ref": "#/$defs/quantity"
        },
        "output": {
          "$ref": "#/$defs/slot"
        },
        "teaching": {
          "$ref": "#/$defs/solutionTeaching"
        }
      }
    },
    "solutionTeaching": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "whyNow",
        "whatToNotice",
        "whyThisOperation",
        "inputMeaning",
        "resultUse"
      ],
      "properties": {
        "whyNow": {
          "type": "string"
        },
        "whatToNotice": {
          "type": "string"
        },
        "whyThisOperation": {
          "type": "string"
        },
        "inputMeaning": {
          "type": "string"
        },
        "resultUse": {
          "type": "string"
        },
        "commonMistakes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "solutionStep": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "title",
        "teaching"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "kind": {
          "enum": [
            "formula",
            "basicMath",
            "conversion",
            "derivative",
            "finalAnswer"
          ]
        },
        "title": {
          "type": "string"
        },
        "formulaId": {
          "$ref": "#/$defs/id"
        },
        "mathOperation": {
          "enum": [
            "add",
            "subtract",
            "multiply",
            "divide",
            "power",
            "sqrt"
          ]
        },
        "conversionId": {
          "$ref": "#/$defs/id"
        },
        "derivativeId": {
          "$ref": "#/$defs/id"
        },
        "bindings": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/id"
          }
        },
        "output": {
          "$ref": "#/$defs/quantity"
        },
        "expectedLatex": {
          "type": "string"
        },
        "teaching": {
          "$ref": "#/$defs/solutionTeaching"
        }
      }
    }
  }
}
